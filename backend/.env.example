# Nucleus Backend Production Environment Template
# ================================================

# Environment & Server
ENVIRONMENT=production
DEBUG=False
PROJECT_NAME=Nucleus
OCI_PUBLIC_IP=YOUR_OCI_PUBLIC_IP_HERE
BACKEND_URL=http://YOUR_OCI_PUBLIC_IP_HERE

# Database Credentials
POSTGRES_USER=nucleus_prod_user
POSTGRES_PASSWORD=CHANGE_THIS_TO_STRONG_SECURE_PASSWORD
POSTGRES_DB=nucleus_prod_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://nucleus_prod_user:CHANGE_THIS_TO_STRONG_SECURE_PASSWORD@db:5432/nucleus_prod_db

# Redis Cache
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# Security Secret Key
SECRET_KEY=CHANGE_THIS_TO_STRONG_HEX_SECRET_KEY

# GitHub OAuth Credentials (Optional)
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
